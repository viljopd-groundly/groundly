rules_version = '2';
// Bilder i reportage och loggade matcher. Alla kan se, bara uppladdaren kan ta bort.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && id.matches('^[0-9a-f]{32}$')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.metadata.owner == request.auth.uid;
    }
  }
}
