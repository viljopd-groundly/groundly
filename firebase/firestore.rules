rules_version = '2';
// Groundly – motsvarar de 30 reglerna som appen hade på claude.ai:
//  * allt gemensamt innehåll kan läsas av alla (även utan konto)
//  * varje användare skriver bara sitt eget dokument, t.ex. forum/{uid}
//  * feedback läses bara av avsändaren och moderatorer
//  * users/{uid}/... (egna loggade matcher) är helt privat
//  * mod/*, matches, meta och config skrivs bara av moderatorer (config/admins.uids)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Ett dokument per användare, läsbart för alla
    match /{coll}/{uid} {
      allow read: if coll in ['forum','ratings','pubs','quiz','reports','likes','stats','hype','votes',
                              'tipnotes','fixes','public','cheers','comments','legends','legvotes','profiles','legacy','trsug','trvote'];
      allow write: if coll in ['forum','ratings','pubs','quiz','reports','likes','stats','hype','votes',
                               'tipnotes','fixes','public','cheers','comments','legends','legvotes','trsug','trvote'] && (isSelf(uid) || isAdmin());
    }
    match /profiles/{uid} {
      allow create, update: if isSelf(uid) && request.resource.data.name is string
                   && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow delete: if isSelf(uid);
    }
    match /feedback/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }
    // Privat: egna loggade matcher
    match /users/{uid}/{rest=**} {
      allow read, write: if isSelf(uid);
    }
    // Moderering, matchschema och inställningar
    match /mod/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /matches/{id} { allow read: if true; allow write: if isAdmin(); }
    match /meta/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /legacy/{id}/{rest=**} { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}  { allow read: if true; allow write: if false; }
    // Anonym användningsstatistik: ett dokument per dag med antal per sak, utan användar-id.
    // Alla får öka räknarna (även utan konto), bara moderatorer kan läsa. summary skrivs av tjänstekontot.
    match /usage/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['s','s_in','s_new','s_pwa','dark','look_std','look_modern','look_ticket','look_atlas','look_kit','lang_sv','lang_nb','lang_da','lang_fi','lang_is','lang_de','lang_en','lang_es','lang_fr','lang_it','lang_nl','lang_pl','lang_pt','v_hem','v_matcher','v_mine','v_resa','v_flode','v_forum','v_reportage','v_klubbar','v_landslag','v_tabell','v_arenor','v_tips','v_quiz','v_profil','m_open','log','wish','trip_new','cal','fav','login_click','trip_search','trip_share','trip_leg','trip_log','trip_top','top_city','home_top','plus','plus_log','plus_trip','plus_rep','plus_ask','out_hotel','out_travel','out_tix','out_ext','c_SE','c_NO','c_DK','c_FI','c_IS','c_DE','c_GB','c_IE','c_NL','c_BE','c_FR','c_ES','c_PT','c_IT','c_CH','c_AT','c_PL','c_CZ','c_HU','c_HR','c_RS','c_GR','c_TR','c_RO','c_UA','c_EE','c_LV','c_LT','c_US','c_CA','c_MX','c_BR','c_AR','c_AU','c_JP','c_TH','c_AE','c_ZA','c_IN','c_CN','c_XX','trip_ask']);
    }
  }
}
